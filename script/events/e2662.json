[
 {
  "id": "e2662_00194",
  "kind": "line",
  "jp": "キミもここの大会にさんかしてるの？",
  "en": "",
  "status": "new",
  "flags": "0x0000",
  "script": 5,
  "notes": ""
 },
 {
  "id": "e2662_001c0",
  "kind": "line",
  "jp": "じゃあ　せいいっぱい応援するよ！",
  "en": "",
  "status": "new",
  "flags": "0x0200",
  "script": 5,
  "notes": ""
 },
 {
  "id": "e2662_00220",
  "kind": "line",
  "jp": "応援しているせんしゅのバトルでは",
  "en": "",
  "status": "new",
  "flags": "0x0000",
  "script": 6,
  "notes": ""
 },
 {
  "id": "e2662_0024c",
  "kind": "line",
  "jp": "声がかれるまで　さけんでしまうんだ",
  "en": "",
  "status": "new",
  "flags": "0x0200",
  "script": 6,
  "notes": ""
 },
 {
  "id": "e2662_00278",
  "kind": "line",
  "jp": "おかげで　のどがガラガラだよ",
  "en": "",
  "status": "new",
  "flags": "0x0200",
  "script": 6,
  "notes": ""
 },
 {
  "id": "e2662_002e0",
  "kind": "line",
  "jp": "そのうち　中学生のマルスが",
  "en": "",
  "status": "new",
  "flags": "0x0000",
  "script": 7,
  "notes": ""
 },
 {
  "id": "e2662_00304",
  "kind": "line",
  "jp": "たんじょうするかもしれないぜ！",
  "en": "",
  "status": "new",
  "flags": "0x0200",
  "script": 7,
  "notes": ""
 },
 {
  "id": "e2662_0032c",
  "kind": "line",
  "jp": "せだいこうたいは　かくじつに",
  "en": "",
  "status": "new",
  "flags": "0x0000",
  "script": 7,
  "notes": ""
 },
 {
  "id": "e2662_00354",
  "kind": "line",
  "jp": "すすんでるんだからな",
  "en": "",
  "status": "new",
  "flags": "0x0200",
  "script": 7,
  "notes": ""
 },
 {
  "id": "e2662_003a8",
  "kind": "line",
  "jp": "この間の大会で　だれがゆうしょうした",
  "en": "",
  "status": "new",
  "flags": "0x0000",
  "script": 8,
  "notes": ""
 },
 {
  "id": "e2662_003d8",
  "kind": "line",
  "jp": "と思う？　なんと中学生だぜ！",
  "en": "",
  "status": "new",
  "flags": "0x0200",
  "script": 8,
  "notes": ""
 },
 {
  "id": "e2662_00400",
  "kind": "line",
